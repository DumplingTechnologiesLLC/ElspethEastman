{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "react/jsx-key": "error"
  },
  "ignorePatterns": [
    "public/",
    "node_modules/",
    "coverage/",
    "storybook-static/",
    "staticfiles/",
    "frontend/src/assets/"
  ]
}
