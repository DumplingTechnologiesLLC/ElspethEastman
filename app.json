{
  "name": "ElspethEastman",
  "description": "Elspeth Eastman's portfolio and CMS",
  "stack": "heroku-24",
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "DEBUG": {
      "description": "Enable debug mode",
      "value": "False"
    },
    "HEROKU": {
      "description": "Running on Heroku",
      "value": "True"
    },
    "SSL_REDIRECT": {
      "description": "Force SSL redirects",
      "value": "True"
    },
    "SECRET_KEY": {
      "description": "Django secret key",
      "generator": "secret"
    },
    "CONTACT_EMAIL": {
      "description": "Contact email address",
      "value": "preview@example.invalid"
    },
    "DEFAULT_FROM_EMAIL": {
      "description": "Default from email",
      "value": "preview@example.invalid"
    },
    "DEFAULT_TO_EMAIL": {
      "description": "Default to email",
      "value": "preview@example.invalid"
    },
    "DEPLOYMENT_ENV": {
      "value": "review",
      "description": "Non-production environment identity"
    },
    "EMAIL_BACKEND": {
      "value": "django.core.mail.backends.console.EmailBackend",
      "description": "Capture review-app mail in logs instead of delivering it"
    },
    "POETRY_VERSION": {
      "value": "2.5.1",
      "description": "Match the Poetry lockfile tool version"
    }
  },
  "environments": {
    "review": {
      "stack": "heroku-24",
      "addons": ["heroku-postgresql:essential-0"]
    }
  }
}
