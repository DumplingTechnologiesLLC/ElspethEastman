{
  "name": "elspeth-eastman",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "heroku-postbuild": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && node --import tsx tooling/check-architecture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:docker": "bash e2e/docker.sh",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@stylexjs/unplugin": "0.19.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.1",
    "oxc-parser": "0.158.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "storybook": "10.6.7",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "unplugin": "2.3.11",
    "vite": "8.3.8",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "5.1.0"
  }
}
